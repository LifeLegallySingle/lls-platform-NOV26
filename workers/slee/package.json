{
  "name": "slee",
  "version": "1.0.0",
  "private": true,
  "description": "SLEE — Single Life Email Engine (Cloudflare Worker + D1), integrated with LLS HUB, sending via Brevo",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply slee --local",
    "db:migrate:remote": "wrangler d1 migrations apply slee --remote",
    "test:event": "node scripts/send-test-event.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.157.0"
  }
}
